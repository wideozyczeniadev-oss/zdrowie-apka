// Homeostaza — schemat danych
// Personalna platforma zarzadzania zdrowiem dla osob z przewleklymi syndromami.

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ============================================================
// PROFIL UZYTKOWNIKA (single-user MVP — jeden rekord)
// ============================================================
model Profile {
  id                  String   @id @default(cuid())
  fullName            String
  heightCm            Int?
  weightKg            Float?
  birthDate           DateTime?
  // diagnozy, eliminacje, triggery jako JSON-strings (SQLite)
  diagnosesJson       String   @default("[]")
  eliminationsJson    String   @default("[]")
  knownTriggersJson   String   @default("[]")
  goal                String?
  notes               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

// ============================================================
// SLOWNIK OBJAWOW (~50 pozycji, klinicznie polski)
// ============================================================
model SymptomDefinition {
  id          Int       @id @default(autoincrement())
  code        String    @unique  // bloating, reflux, brain_fog...
  namePl      String
  nameEn      String?
  category    String    // gut | mood | energy | cognition | skin | joints_muscles | sleep | vascular
  description String?
  events      Event[]   @relation("SymptomEvents")
}

// ============================================================
// PROTOKOL SUPLEMENTACYJNY (lista suplementow uzytkownika)
// ============================================================
model SupplementProtocol {
  id           String   @id @default(cuid())
  name         String
  defaultTime  String?  // "07:30" lub null jesli reguly
  timingRule   String?  // "Przed snem", "30 min przed posilkiem", "1.5h po kolacji"
  purpose      String?
  dosage       String?
  active       Boolean  @default(true)
  events       Event[]  @relation("SupplementEvents")
  createdAt    DateTime @default(now())
}

// ============================================================
// DZIEN (jeden rekord per data uzytkownika)
// ============================================================
model Day {
  id                    String    @id @default(cuid())
  date                  DateTime  @unique  // tylko data, bez godziny
  // morning check-in
  morningSleepQuality   Int?
  morningSleepDurationH Float?
  morningEnergy         Int?
  morningMood           Int?
  // evening reflection
  eveningEnergy         Int?
  eveningOverall        Int?
  eveningStress         Int?
  whatWorked            String?
  whatDidntWork         String?
  notes                 String?
  source                String?   // "manual" | "import:chat_zdrowie" | ...
  events                Event[]
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([date])
}

// ============================================================
// ZDARZENIA (meal | supplement | symptom | activity | break)
// ============================================================
enum EventType {
  MEAL
  SUPPLEMENT
  SYMPTOM
  ACTIVITY
  BREAK
}

model Event {
  id          String     @id @default(cuid())
  dayId       String
  day         Day        @relation(fields: [dayId], references: [id], onDelete: Cascade)
  type        EventType
  occurredAt  DateTime
  // wspolne pola
  description String?
  severity    Int?       // dla SYMPTOM (1-10)
  // referencje (opcjonalne)
  symptomDefinitionId Int?
  symptomDefinition   SymptomDefinition? @relation("SymptomEvents", fields: [symptomDefinitionId], references: [id])
  supplementProtocolId String?
  supplementProtocol   SupplementProtocol? @relation("SupplementEvents", fields: [supplementProtocolId], references: [id])
  // dodatkowe dane jako JSON (post_meal_symptoms, tags, duration, intensity, ...)
  metaJson    String?
  createdAt   DateTime   @default(now())

  @@index([dayId, occurredAt])
  @@index([type])
}
