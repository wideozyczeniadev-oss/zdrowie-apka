// Zdrowie-apka schema
// Aktywności dnia: posiłki, treningi, rutyny zdrowotne

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum ActivityType {
  MEAL
  WORKOUT
  ROUTINE
}

enum Recurrence {
  ONCE
  DAILY
  WEEKDAYS
  WEEKLY
}

model Activity {
  id          String        @id @default(cuid())
  type        ActivityType
  title       String
  description String?
  time        String
  recurrence  Recurrence    @default(DAILY)
  weekdays    String?
  calories    Int?
  protein     Int?
  durationMin Int?
  notes       String?
  active      Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  logs        ActivityLog[]
}

model ActivityLog {
  id          String    @id @default(cuid())
  activityId  String
  activity    Activity  @relation(fields: [activityId], references: [id], onDelete: Cascade)
  scheduledAt DateTime
  completedAt DateTime?
  notifiedAt  DateTime?
  notes       String?
  createdAt   DateTime  @default(now())

  @@unique([activityId, scheduledAt])
  @@index([scheduledAt])
}
